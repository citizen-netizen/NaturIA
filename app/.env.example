# URL del Worker de Cloudflare que hace de proxy de OpenRouter.
# Sin esta variable la app funciona igual, pero el tutor responde siempre
# desde la base de conocimiento local.
VITE_API_URL=https://naturia-api.TU-SUBDOMINIO.workers.dev

# Ruta base del sitio. Por defecto /NaturIA/ (GitHub Pages, sensible a
# mayúsculas). Para un dominio propio: VITE_BASE=/
# VITE_BASE=/
