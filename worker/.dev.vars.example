# Copia este archivo a `.dev.vars` para desarrollo local.
# `.dev.vars` está en .gitignore: la clave real nunca debe llegar al repositorio.
#
# En producción la clave se carga como secreto de Cloudflare:
#   npx wrangler secret put AI_API_KEY

# Con AI_PROVIDER=gemini, una clave de https://aistudio.google.com/
# Con AI_PROVIDER=openrouter, una clave de https://openrouter.ai/
AI_API_KEY=tu-clave-aqui

# Opcional, solo para pruebas: apunta el proxy a un simulador local
# en vez de al proveedor real, para no gastar cuota.
# AI_BASE_URL=http://localhost:9911
